# Explicit SDKs are isolated from system libraries; an empty root uses target pkg-config.
set(FFMPEG_ROOT "${EMBEDDED_DEFAULT_FFMPEG_ROOT}" CACHE PATH "Target FFmpeg SDK prefix; empty selects pkg-config")
set(FFMPEG_LIBS)
set(_ffmpeg_components avcodec avformat avutil avdevice avfilter swscale swresample)
if(FFMPEG_ROOT)
    set(FFMPEG_INCLUDE_DIR "${FFMPEG_ROOT}/include")
    set(FFMPEG_LIB_DIR "${FFMPEG_ROOT}/lib")
    if(NOT EXISTS "${FFMPEG_INCLUDE_DIR}/libavcodec/avcodec.h")
        message(FATAL_ERROR "Missing target FFmpeg SDK at ${FFMPEG_ROOT}. Provide matching target headers/libraries via FFMPEG_ROOT. API compatibility is determined by the enabled modules.")
    endif()
    foreach(component IN LISTS _ffmpeg_components)
        find_library(FFMPEG_${component}_LIBRARY NAMES ${component}
            PATHS "${FFMPEG_LIB_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
        list(APPEND FFMPEG_LIBS "${FFMPEG_${component}_LIBRARY}")
    endforeach()
    if(UNIX AND NOT APPLE AND NOT CMAKE_CROSSCOMPILING)
        list(APPEND CMAKE_BUILD_RPATH "${FFMPEG_LIB_DIR}")
        add_link_options("LINKER:--disable-new-dtags")
    endif()
else()
    find_package(PkgConfig REQUIRED)
    foreach(component IN LISTS _ffmpeg_components)
        pkg_check_modules(FFMPEG_${component} REQUIRED IMPORTED_TARGET lib${component})
        set(FFMPEG_${component}_LIBRARY "PkgConfig::FFMPEG_${component}")
        list(APPEND FFMPEG_LIBS "PkgConfig::FFMPEG_${component}")
    endforeach()
    set(FFMPEG_INCLUDE_DIR ${FFMPEG_avcodec_INCLUDE_DIRS})
endif()
file(GLOB FFMPEG_RUNTIME_DLLS CONFIGURE_DEPENDS "${FFMPEG_ROOT}/bin/*.dll")
