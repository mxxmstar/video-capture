option(BUILD_MEDIA "Build media capture, codecs and streaming" ON)
option(BUILD_RENDER "Build OpenGL rendering" ${EMBEDDED_DEFAULT_BUILD_RENDER})
option(BUILD_TESTS "Build test programs" ON)
option(BUILD_MEDIA_TESTS "Build media test programs" ON)
option(MEDIA_RAW_FRAME_BUFFER "Retain AVFrame owners instead of copying" OFF)
set(_v4l2_default OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_v4l2_default ON)
endif()
option(BUILD_V4L2_CAPTURE "Build native Linux V4L2 capture" ${_v4l2_default})
if(BUILD_V4L2_CAPTURE AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Native V4L2 capture requires Linux")
endif()
if(BUILD_RENDER AND NOT BUILD_MEDIA)
    message(FATAL_ERROR "BUILD_RENDER requires BUILD_MEDIA=ON")
endif()
foreach(kind RUNTIME ARCHIVE LIBRARY)
    if(kind STREQUAL "RUNTIME")
        set(_output "${CMAKE_BINARY_DIR}/bin")
    else()
        set(_output "${CMAKE_BINARY_DIR}/lib")
    endif()
    set(CMAKE_${kind}_OUTPUT_DIRECTORY "${_output}")
    foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
        set(CMAKE_${kind}_OUTPUT_DIRECTORY_${config} "${_output}")
    endforeach()
endforeach()
