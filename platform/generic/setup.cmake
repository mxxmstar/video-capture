set(EMBEDDED_DEFAULT_BUILD_RENDER ON)
option(EMBEDDED_USE_VCPKG "Resolve generic dependencies through vcpkg" ON)
if(EMBEDDED_USE_VCPKG)
    if(CMAKE_HOST_WIN32)
        set(_root "C:/vcpkg_env/vcpkg")
        set(_installed "C:/vcpkg_env/vcpkg_installed")
        set(_triplet x64-windows)
    else()
        set(_root "$ENV{HOME}/vcpkg")
        set(_installed "$ENV{HOME}/vcpkg_env/vcpkg_installed")
        set(_triplet x64-linux)
    endif()
    if(DEFINED ENV{VCPKG_ROOT})
        set(_root "$ENV{VCPKG_ROOT}")
    endif()
    if(DEFINED ENV{VCPKG_INSTALLED_DIR})
        set(_installed "$ENV{VCPKG_INSTALLED_DIR}")
    endif()
    set(VCPKG_TARGET_TRIPLET "${_triplet}" CACHE STRING "Vcpkg target triplet")
    set(VCPKG_INSTALLED_DIR "${_installed}" CACHE PATH "Vcpkg installed directory")
    if(NOT DEFINED CMAKE_TOOLCHAIN_FILE)
        set(CMAKE_TOOLCHAIN_FILE "${_root}/scripts/buildsystems/vcpkg.cmake" CACHE FILEPATH "Vcpkg toolchain")
    endif()
endif()
